{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/API Serve/src/app.ts",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/Trading Dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "artifacts/API Serve/src/app.ts"
    },
    {
      "src": "/(.*)",
      "dest": "artifacts/Trading Dashboard/$1"
    }
  ]
}
